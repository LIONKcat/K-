{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "description": "__MSG_appDesc__",
  "default_locale": "zh_CN",
  "version": "1.7.0",
  "permissions": ["storage"],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://robertsspaceindustries.com/*"],
      "js": [
        "config.js",
        "dictionary.js",
        "api.js",
        "parser.js",
        "ui.js",
        "styles.js",
        "snapshot.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}